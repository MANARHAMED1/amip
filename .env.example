# PostgreSQL
POSTGRES_DB=amip
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# Backend
AMIP_DB_HOST=db
AMIP_DB_PORT=5432
AMIP_DB_NAME=amip
AMIP_DB_USER=postgres
AMIP_DB_PASSWORD=change_me_in_production
AMIP_JWT_SECRET=change_me_to_a_random_string

# SMTP (email alerts)
# For Gmail: smtp.gmail.com, port 587, use an App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=yourapp@gmail.com
NOTIFY_EMAIL=youremail@gmail.com
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Frontend (built into nginx at build time, no runtime env needed)
